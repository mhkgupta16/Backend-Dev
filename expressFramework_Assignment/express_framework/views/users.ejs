<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
     <h1>User List</h1>

    <form method="GET" action="/users">
        <input 
            type="text" 
            name="name" 
            placeholder="Search by name"
            value="<%= search || '' %>"
        >
        <button type="submit">Search</button>
    </form>

    <hr>

    <% if (users.length > 0) { %>
        <ul>
            <% users.forEach(user => { %>
                <li><%= user.name %></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No users found.</p>
    <% } %>
</body>
</html>